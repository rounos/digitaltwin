{"id": "chat-036", "channel": "messenger", "participants": ["Eleni", "Κατερίνα"], "date": "2025-07-22", "related_scenario": null, "messages": [{"from": "Κατερίνα", "ts": "2025-07-22T16:00:00+02:00", "text": "Πάμε για καφέ;"}, {"from": "Eleni", "ts": "2025-07-22T16:02:00+02:00", "text": "Ναι, φρέντο εσπρέσο χωρίς ζάχαρη. Στη γωνία στις 17:30;"}]}
