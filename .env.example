# EchoMind — GPT-6 Luna (OpenAI). This file is safe to commit; never commit .env.
# Generate a NEW API key at https://platform.openai.com/api-keys
# Do NOT reuse a key that was posted in a chat or elsewhere.
LLM_PROVIDER=openai
OPENAI_API_KEY= 
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=8192
# Other providers remain optional. Leave their keys blank for OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=/app/data
MASK_PII=true
